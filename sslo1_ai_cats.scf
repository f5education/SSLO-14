TMSH-VERSION: 21.1.0

sys url-db url-category /Common/Generative_AI_-_Conversation {
    cat-id 0
    cat-number 1902
    default-action allow
    display-name "Generative AI - Conversation"
    f5-id 17002
    initial-disposition 4
    is-custom true
    urls {
        https://\*.mem.ai/ {
            type glob-match
        }
        https://get.mem.ai/ { }
    }
}
sys url-db url-category /Common/Generative_AI_-_Multimedia {
    cat-id 0
