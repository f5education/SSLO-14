apm policy customization-source /Common/modern { }
apm policy customization-source /Common/standard { }
apm policy policy-item /Common/kerberos_auth_config_default_act_kerberos_auth {
    agents {
        /Common/kerberos_auth_config_default_act_kerberos_auth_ag {
            type aaa-kerberos
        }
    }
    caption "Kerberos Auth"
    color 1
    item-type action
    rules {
        {
            caption Successful
            expression "expr {[mcget {session.kerberos.last.authresult}] == 1}"
            next-item /Common/kerberos_auth_config_default_end_allow
        }
        {
            caption fallback
            next-item /Common/kerberos_auth_config_default_end_deny
        }
    }
}
apm policy policy-item /Common/kerberos_auth_config_default_end_allow {
    agents {
        /Common/kerberos_auth_config_default_end_allow_ag {
            type ending-allow
        }
    }
    caption Allow
    color 1
    item-type ending
}
apm policy policy-item /Common/kerberos_auth_config_default_end_deny {
    agents {
        /Common/kerberos_auth_config_default_end_deny_ag {
            type ending-deny
        }
    }
    caption Deny
    color 2
    item-type ending
}
apm policy policy-item /Common/kerberos_auth_config_default_ent {
    caption Start
    color 1
    rules {
        {
            caption fallback
            next-item /Common/kerberos_auth_config_default_act_kerberos_auth
        }
    }
}
apm policy policy-item /Common/ssloDefault_end_allow {
    agents {
        /Common/ssloDefault_end_allow_ag {
            type ending-allow
        }
    }
    app-service /Common/ssloGS_global.app/ssloGS_global
    caption Allow
    color 1
    item-type ending
}
apm policy policy-item /Common/ssloDefault_end_deny {
    agents {
        /Common/ssloDefault_end_deny_ag {
            type ending-deny
        }
    }
    app-service /Common/ssloGS_global.app/ssloGS_global
    caption Deny
    color 2
    item-type ending
}
apm policy policy-item /Common/ssloDefault_ent {
    app-service /Common/ssloGS_global.app/ssloGS_global
    caption Start
    color 1
    rules {
        {
            caption fallback
            next-item /Common/ssloDefault_end_allow
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_ip_protocol_lookup {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "IP Protocol Lookup"
    color 1
    item-type action
    rules {
        {
            caption TCP
            expression "expr { [ IP::protocol ] == 6 }"
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_protocol_lookup
        }
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_reject
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_protocol_lookup {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_protocol_lookup_ag {
            type l7-protocol-lookup
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "L7 Protocol Lookup"
    color 1
    item-type action
    rules {
        {
            caption HTTP(S)
            expression "expr { [mcget {perflow.l7_protocol_lookup.result}] == \"https\" || [mcget {perflow.l7_protocol_lookup.result}] == \"http\" }"
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_redirect
        }
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_reject
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_session_check {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_session_check_ag {
            type session-check
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "Session Check"
    color 1
    item-type action
    rules {
        {
            caption "Session Found"
            expression "expr { [mcget {perflow.session_check.session_found}] == 1 }"
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_mac_pinners_rule
        }
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_ip_protocol_lookup
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_ssl_bypass_set_1 {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_ssl_bypass_set_1_ag {
            type ssl-bypass-set
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "SSL Bypass Set"
    color 1
    item-type action
    rules {
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow_Pinners_Rule
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_abort {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_abort_ag {
            type ending-abort
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Abort
    color 20
    item-type ending
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow_ag {
            type ending-allow
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "All Traffic"
    color 1
    item-type ending
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow_Pinners_Rule {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow_Pinners_Rule_ag {
            type ending-allow
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Pinners_Rule
    color 1
    item-type ending
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_redirect {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_redirect_ag {
            type ending-redirect
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Redirect
    color 16
    item-type ending
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_reject {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_reject_ag {
            type ending-reject
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Reject
    color 2
    item-type ending
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_ent {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Start
    color 1
    rules {
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_session_check
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_mac_pinners_rule {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Pinners_Rule
    color 1
    item-type macro-call
    macro /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_macro_policy
    rules {
        {
            caption Pass
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_ssl_bypass_set_1
        }
        {
            caption Fail
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_mac_sslosc_user_coaching_1
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_mac_sslosc_user_coaching_1 {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption ssloSC_user_coaching
    color 1
    item-type macro-call
    macro /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_macro_policy
    rules {
        {
            caption Out
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_act_sni_category_lookup {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_act_sni_category_lookup_ag {
            type category-lookup
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "Category Lookup"
    color 1
    item-type action
    rules {
        {
            caption "Category Match"
            expression "expr { [mcget {perflow.category_lookup.result.categories}] contains \"| 1901 |\" }"
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_out
        }
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_out_failed
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_act_ssl_check {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_act_ssl_check_ag {
            type ssl-check
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "SSL Check"
    color 1
    item-type action
    rules {
        {
            caption "SSL Found"
            expression "expr { [mcget {perflow.ssl_check.ssl_found}] == 1 }"
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_act_sni_category_lookup
        }
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_out_failed
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_ent {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption In
    color 1
    rules {
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outboundpinners_rule_act_ip_protocol_lookup
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_out {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Pass
    color 1
    item-type terminal-out
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_out_failed {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Fail
    color 2
    item-type terminal-out
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_ip_family_check {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "IP Version Check"
    color 1
    item-type action
    rules {
        {
            caption IPv4
            expression "expr { [ IP::version ] == 4 }"
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_protocol_lookup_4
        }
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_out
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_protocol_lookup_4 {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_protocol_lookup_4_ag {
            type l7-protocol-lookup
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "L7 Protocol Lookup"
    color 1
    item-type action
    rules {
        {
            caption "HTTP(S) and HTTP Connect"
            expression "expr { [mcget {perflow.l7_protocol_lookup.result}] == \"https\" || [mcget {perflow.l7_protocol_lookup.result}] == \"http\" || [mcget {perflow.l7_protocol_lookup.result}] == \"http-connect\" }"
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_svc_connect_4_t
        }
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_out
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_svc_connect_4_t {
    agents {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_svc_connect_4_t_ag {
            type service-connect
        }
    }
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption "Service Connect (ssloS_F5_UC)"
    color 1
    item-type action
    rules {
        {
            caption fallback
            next-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_out
        }
    }
}
apm policy policy-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_ent {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
