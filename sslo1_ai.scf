    errormap-group /Common/sslo_L3_outbound.app/sslo_L3_outbound_errormap
    framework-installation-group /Common/sslo_L3_outbound.app/sslo_L3_outbound_framework_installation
    general-ui-group /Common/sslo_L3_outbound.app/sslo_L3_outbound_general_ui
    generation 1
    generation-action noop
    log-settings {
        /Common/sslo_L3_outbound.app/sslo_L3_outbound-log-setting
    }
    named-scope none
    persistent-cookie true
    primary-auth-service none
    scope public
    type ssl-orchestrator
    user-identity-method http
}
