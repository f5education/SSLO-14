#TMSH-VERSION: 21.1.0

cli admin-partitions {
    update-partition Common
}
apm log-setting /Common/sslo_L3_outbound.app/sslo_L3_outbound-log-setting {
    access {
        general-log {
            app-service /Common/sslo_L3_outbound.app/sslo_L3_outbound
            publisher /Common/sys-sslo-publisher
            type ssl-orchestrator
            log-level {
                access-control err
                access-per-request err
            }
        }
    }
    app-service /Common/sslo_L3_outbound.app/sslo_L3_outbound
    url-filters {
        urlf {
            app-service /Common/sslo_L3_outbound.app/sslo_L3_outbound
            publisher /Common/sys-sslo-publisher
        }
    }
}
apm ephemeral-auth ssh-security-config /Common/ssh-security-config {
    ciphers {
        1 {
            cipher-name aes256-ctr
        }
        2 {
            cipher-name aes192-ctr
        }
        3 {
            cipher-name aes128-ctr
        }
    }
    compressions {
        1 {
            compression-name none
        }
    }
    hmacs {
        1 {
            hmac-name hmac-sha2-512
        }
        2 {
            hmac-name hmac-sha2-256
        }
    }
    kex-methods {
        1 {
            kex-method-name ecdh-sha2-nistp256
        }
    }
}
apm epsec epsec-package /Common/epsec-1.0.0-1994.0.iso {
    cache-path /config/filestore/files_d/Common_d/epsec_package_d/:Common:epsec-1.0.0-1994.0.iso_61747_1
    oesis-version 4.3.5842.0
    revision 1
    version 1.0.0-1994.0
}
apm oauth db-instance /Common/oauthdb {
    description "Default OAuth DB."
}
apm policy access-policy /Common/kerberos_auth_config_default {
    default-ending /Common/kerberos_auth_config_default_end_deny
    items {
        /Common/kerberos_auth_config_default_act_kerberos_auth { }
        /Common/kerberos_auth_config_default_end_allow { }
        /Common/kerberos_auth_config_default_end_deny { }
        /Common/kerberos_auth_config_default_ent { }
    }
    start-item /Common/kerberos_auth_config_default_ent
}
apm policy access-policy /Common/ssloDefault_accessPolicy {
    app-service /Common/ssloGS_global.app/ssloGS_global
    caption general
    default-ending /Common/ssloDefault_end_allow
    items {
        /Common/ssloDefault_end_allow { }
        /Common/ssloDefault_end_deny { }
        /Common/ssloDefault_ent { }
    }
    start-item /Common/ssloDefault_ent
}
apm policy access-policy /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption general
    default-ending /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow
    items {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_ip_protocol_lookup { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_protocol_lookup { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_session_check { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_act_ssl_bypass_set_1 { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_abort {
            priority 7
        }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow {
            priority 8
        }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_allow_Pinners_Rule {
            priority 8
        }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_redirect {
            priority 7
        }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_end_reject {
            priority 7
        }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_ent { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_mac_pinners_rule { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_mac_sslosc_user_coaching_1 { }
    }
    macros { /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_macro_policy /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_macro_policy /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_macro_policy }
    per-req-policy-properties {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy {
            incomplete-action allow
        }
    }
    start-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_per_req_policy_ent
    type ssl-orchestrator-policy
}
apm policy access-policy /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_macro_policy {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption Pinners_Rule
    default-ending /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_out
    items {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_act_sni_category_lookup { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_act_ssl_check { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_ent { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_out {
            priority 4
        }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_out_failed {
            priority 5
        }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outboundpinners_rule_act_ip_protocol_lookup { }
    }
    start-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_pinners_rule_ent
    type ssl-orchestrator-policy-macro
}
apm policy access-policy /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_macro_policy {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption ssloS_F5_UC
    default-ending /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_out
    items {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_ip_family_check { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_protocol_lookup_4 { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_act_svc_connect_4_t { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_ent { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_out {
            priority 1
        }
    }
    start-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslos_f5_uc_ent
    type ssl-orchestrator-policy-macro
}
apm policy access-policy /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_macro_policy {
    app-service /Common/ssloP_L3_outbound.app/ssloP_L3_outbound
    caption ssloSC_user_coaching
    default-ending /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_out
    items {
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_act_variable_assign { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_ent { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_mac_sslos_f5_uc { }
        /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_out {
            priority 1
        }
    }
    oneshot-macro true
    start-item /Common/ssloP_L3_outbound.app/ssloP_L3_outbound_sslosc_user_coaching_ent
    type ssl-orchestrator-policy-macro
}
apm policy access-policy /Common/sslo_L3_outbound.app/sslo_L3_outbound_accessPolicy {
    app-service /Common/sslo_L3_outbound.app/sslo_L3_outbound
    caption general
